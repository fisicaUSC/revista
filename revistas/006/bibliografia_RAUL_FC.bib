@article{raul_2,
	title = {Frustrated total internal reflection: the Newton experiment revisited},
	volume = {116},
	url = {https://ui.adsabs.harvard.edu/abs/2022Phot..116...32C},
	doi = {10.1051/photon/202211632},
	shorttitle = {Frustrated total internal reflection},
	abstract = {Three centuries ago, Isaac Newton reported the experimental observation of the tunnelling of a light ray between two prisms separated by a small gap once one of them was shinned in total internal reflection. This article describes a modern revisit of this seminal Newton's experiment, generally known as the Frustrated Total Internal Reflection. This experiment was created in the framework of a series of lectures about near-field optics and nanophotonics for Master students. During a 4h lab work session, the students are running the experiment to evidence and quantify the evanescent wave on top of a glass prism once illuminated above the critical angle.},
	pages = {32--37},
	journaltitle = {Photoniques},
	publisher = {{EDP}},
	author = {Cluzel, Benoit and De Fornel, Frédérique},
	urldate = {2026-09-14},
	date = {2022-11-01},
	note = {{ADS} Bibcode: 2022Phot..116...32C},
	file = {Texto completo:/home/stoneboy/Zotero/storage/R85V9ZVG/Cluzel y De Fornel - 2022 - Frustrated total internal reflection the Newton experiment revisited.pdf:application/pdf},
}
